{
  "name": "commerce-shipping-table-rates",
  "version": "0.1.0",
  "private": true,
  "description": "Shipping Table Rates for Adobe Commerce: rate tables by destination, weight, subtotal, quantity and SKU, served to checkout through the out-of-process shipping method webhook, with an Admin page on App Builder.",
  "keywords": [
    "adobe-commerce",
    "app-builder",
    "magento",
    "shipping",
    "table-rates",
    "matrix-rates",
    "webhooks"
  ],
  "homepage": "https://github.com/sohelrana09/commerce-shipping-table-rates#readme",
  "bugs": {
    "url": "https://github.com/sohelrana09/commerce-shipping-table-rates/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohelrana09/commerce-shipping-table-rates.git"
  },
  "license": "MIT",
  "author": "Sohel Rana",
  "type": "module",
  "imports": {
    "#app.commerce.config": "./src/commerce-extensibility-1/.generated/app.commerce.config.js",
    "#web/*": "./src/commerce-backend-ui-2/web-src/src/*",
    "#engine": "./src/common/rates/engine.js",
    "#csv": "./src/common/rates/csv.js"
  },
  "scripts": {
    "admin:preview": "node scripts/ensure-web-config.js && node scripts/admin-preview.js",
    "code:check": "npx biome check .",
    "code:fix": "npx biome check --write .",
    "postinstall": "npx aio-commerce-lib-app hooks postinstall",
    "test": "vitest run --coverage",
    "typecheck": "node scripts/ensure-web-config.js && tsc --noEmit -p src/commerce-backend-ui-2/web-src/tsconfig.json"
  },
  "dependencies": {
    "@adobe/aio-commerce-lib-admin-ui": "^1.3.0",
    "@adobe/aio-commerce-lib-app": "^2.2.0",
    "@adobe/aio-commerce-lib-auth": "^1.3.0",
    "@adobe/aio-commerce-lib-config": "^1.9.0",
    "@adobe/aio-commerce-sdk": "^2.1.0",
    "@adobe/aio-lib-core-auth": "^1.2.0",
    "@adobe/aio-lib-core-logging": "^3.0.2",
    "@adobe/aio-lib-db": "^1.1.0",
    "@react-spectrum/s2": "^1.8.2",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-react": "^7.29.7",
    "@biomejs/biome": "^2.6.7",
    "@parcel/config-default": "^2.16.4",
    "@parcel/core": "^2.16.4",
    "@tsconfig/bases": "^1.0.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^21.0.4",
    "parcel": "^2.16.4",
    "typescript": "^6.0.3",
    "ultracite": "^8.2.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "@parcel/bundler-default": {
    "manualSharedBundles": [
      {
        "name": "s2-styles",
        "assets": [
          "**/@react-spectrum/s2/**",
          "src/commerce-backend-ui-2/web-src/*.{js,jsx,ts,tsx}"
        ],
        "types": [
          "css"
        ]
      }
    ]
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
