# Log level for runtime actions: debug, info, warn or error
LOG_LEVEL=info

# The PEM public key from Stores > Configuration > Adobe Services > Webhooks (Digital Signature
# Configuration). Keep the line breaks as \n. Without it, the shipping webhook rejects every request.
COMMERCE_WEBHOOK_PUBLIC_KEY=

# Shipping methods as JSON (see docs/rate-tables.md). Leave empty to use the methods managed on the Admin page.
SHIPPING_METHODS=
