# Editor defaults (VS Code needs the EditorConfig extension; WebStorm reads it natively). Biome enforces the same for code.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
